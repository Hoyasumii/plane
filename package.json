{
  "name": "@hoyasumii/plane",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Plane API (v1 and v2), with an MCP server and a CLI for AI agents",
  "author": "Alan Reis",
  "contributors": [
    "Plane <engineering@plane.so>"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Hoyasumii/plane.git"
  },
  "homepage": "https://hoyasumii.github.io/plane/",
  "bugs": {
    "url": "https://github.com/Hoyasumii/plane/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "default": "./dist/mcp/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "mcp": [
        "dist/mcp/index.d.ts"
      ]
    }
  },
  "bin": {
    "plane-mcp": "dist/mcp/cli.js",
    "plane": "dist/cli/index.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:types-bundle": "dts-bundle-generator --no-check -o dist/types.bundle.d.ts dist/index.d.ts",
    "build": "tsc && pnpm run build:types-bundle && node scripts/check-types-bundle.mjs",
    "prepublishOnly": "pnpm check:types && pnpm test:unit && pnpm build",
    "dev": "tsc --watch",
    "test": "jest",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:e2e": "jest --testPathPattern=tests/e2e",
    "test:all": "pnpm test:unit && pnpm test:e2e",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "clean": "node -e \"for (const dir of ['dist', 'node_modules']) require('fs').rmSync(dir, { recursive: true, force: true })\"",
    "check:types": "tsc --noEmit -p tsconfig.jest.json",
    "check:lint": "oxlint",
    "fix:lint": "oxlint --fix",
    "check:format": "oxfmt --check",
    "fix:format": "oxfmt",
    "codegen:v2": "node scripts/generate-v2-constants.mjs",
    "check:types-bundle": "node scripts/check-types-bundle.mjs",
    "codegen:mcp": "ts-node --transpile-only --project tsconfig.jest.json scripts/build-mcp-catalog.ts",
    "mcp": "node dist/mcp/cli.js",
    "cli": "node dist/cli/index.js",
    "docs:dev": "pnpm --filter @hoyasumii/plane-website start",
    "docs:build": "pnpm --filter @hoyasumii/plane-website build",
    "docs:serve": "pnpm --filter @hoyasumii/plane-website serve",
    "docs:deploy": "pnpm --filter @hoyasumii/plane-website run deploy",
    "prepare": "husky",
    "check:knip": "knip",
    "fix:knip": "knip --fix"
  },
  "keywords": [
    "plane",
    "plane.so",
    "project-management",
    "sdk",
    "api-client",
    "typescript",
    "node",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "cli",
    "work-items",
    "ai-agents",
    "claude"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "axios": "1.20.0",
    "citty": "^0.1.6",
    "cross-spawn": "^7.0.6",
    "jsonc-parser": "^3.3.1",
    "marked": "^15.0.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/cross-spawn": "^6.0.6",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "dotenv": "^17.4.2",
    "dts-bundle-generator": "^9.5.1",
    "husky": "^9.1.7",
    "jest": "^29.0.0",
    "knip": "^6.38.0",
    "nock": "^14.0.17",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.0",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1",
  "engines": {
    "node": ">=20.0.0"
  }
}
